# Your Anthropic API key.
#   • Local dev: paste your key here (the app uses it as the server key).
#   • Public Vercel deploy: LEAVE BLANK so visitors bring their own key in the
#     UI (they can't skip it — the key gate blocks use — and you pay nothing).
ANTHROPIC_API_KEY=your-api-key-here

# Optional — agent model. Default: claude-opus-4-8 (highest quality).
# Set claude-sonnet-5 for faster, cheaper responses if you prefer.
AGENT_MODEL=
